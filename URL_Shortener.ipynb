        "import pyshorteners\n",
        "\n",
        "url = input(\"Enter URL: \")\n",
        "\n",
        "shortener = pyshorteners.Shortener()\n",
        "\n",
        "short_url = shortener.tinyurl.short(url)\n",
        "\n",
        "print(\"Short URL:\", short_url)"
